package environnement_microbalises_expert {

    // 1. Définition technique des composants
    package composants {
        part def PosteCommandement {
            port antenneBase;
        }
        part def ObstacleRadio {
            attribute attenuationdB: Real;
        }
        
        part def MicroBalise {
            attribute masseKg: Real = 0.15;
            attribute porteeMaxMetres: Real = 150.0;
            port moduleRF; // Interface de communication
        }

        part def RoverUGV {
            attribute reserveBalises: Integer = 4; // Contrainte de capacité d'emport
            port antennePrincipale;
            port systemeLargage; // Interface mécanique
        }
    }

    private import composants::*;

    // 2. Vue détaillée des interconnexions physiques et logiques
    part def VueDeploiementBalises {
        part poste: PosteCommandement;
        part obstacle: ObstacleRadio;
        part balise[0..4]: MicroBalise; // Multiplicité : on limite au stock physique
        part rover: RoverUGV;

        // Connexions structurelles via les ports 
        connection liaisonDirecte connect rover.antennePrincipale to poste.antenneBase;
        connection actionLargage connect rover.systemeLargage to balise;
        
        // Le réseau maillé en action
        connection liaisonRelais connect rover.antennePrincipale to balise.moduleRF;
        connection retourBase connect balise.moduleRF to poste.antenneBase;

        // Perturbation déclenchant le système
        flow perturbation from obstacle to liaisonDirecte;
    }
}